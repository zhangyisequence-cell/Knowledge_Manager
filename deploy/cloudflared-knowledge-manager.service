[Unit]
Description=Outbound-only Cloudflare Tunnel for WeChat callback
After=network-online.target knowledge-manager-wechat.service
Wants=network-online.target
ConditionPathExists=/etc/knowledge-manager/cloudflared/config.yml

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/knowledge-manager-cloudflared
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/knowledge-manager/cloudflared

[Install]
WantedBy=multi-user.target
