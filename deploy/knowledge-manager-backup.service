[Unit]
Description=Verified knowledge vault and database backup
After=network-online.target

[Service]
Type=oneshot
UMask=0077
ExecStart=/opt/knowledge-manager/current/.venv/bin/python /opt/knowledge-manager/current/scripts/server_backup.py create
TimeoutStartSec=infinity
TimeoutStopSec=240
# Let Python handle SIGTERM and complete service recovery before killing children.
KillMode=mixed
Nice=10
